{
  "name": "@beep/monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnussman/beep.git"
  },
  "author": "Banks Nussman",
  "scripts": {
    "dev": "FORCE_COLOR=1 bun run --parallel --filter '*' dev",
    "start:api": "bun --filter @beep/api start",
    "start:app": "bun --filter @beep/app start",
    "start:website": "bun --filter @beep/website dev",
    "build:website": "bun --filter @beep/website build",
    "typecheck": "bun run --parallel --filter '*'  typecheck"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["drizzle-kit", "@pulumi/pulumi", "@pulumi/kubernetes", "@pulumi/docker"],
  "workspaces": [
    "app",
    "website",
    "api",
    "test",
    "deploy"
  ]
}
